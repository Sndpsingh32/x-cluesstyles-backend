NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Choose one: mysql or mongodb
DB_CLIENT=mysql

# MySQL settings (used when DB_CLIENT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=starter_db
MYSQL_USER=sandeep
MYSQL_PASSWORD=Password@123
MYSQL_CONNECTION_LIMIT=10

# MongoDB settings (used when DB_CLIENT=mongodb)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=starter_db

JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
